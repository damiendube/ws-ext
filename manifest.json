{
  "manifest_version": 3,
  "name": "Wealthsimple ROI Analyzer",
  "version": "1.0.0",
  "description": "Advanced return on investment graphs for Wealthsimple accounts",
  "permissions": [
    "activeTab",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://wealthsimple.com/*",
    "https://*.wealthsimple.com/*",
    "https://www.blackrock.com/*",
    "https://www.ishares.com/*",
    "https://www.vanguard.ca/*",
    "https://investor.vanguard.com/*",
    "https://www.bmogam.com/*",
    "https://www.globalx.ca/*",
    "https://fc.yahoo.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://wealthsimple.com/*", "https://*.wealthsimple.com/*"],
      "js": ["wealthsimple_api.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "64": "icons/icons8-graph-64.png"
    }
  },
  "icons": {
      "64": "icons/icons8-graph-64.png"
  }
}

